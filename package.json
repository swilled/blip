{
  "name": "blip",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:extension-key": "tsx scripts/gen-extension-key.ts",
    "fixtures:update": "tsx scripts/gen-golden.ts",
    "protocol:lock": "tsx scripts/gen-lock.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
