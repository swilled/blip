{
  "name": "blip",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ext:build": "npm run build --workspace @blip/extension",
    "ext:watch": "npm run watch --workspace @blip/extension",
    "ext:typecheck": "npm run typecheck --workspace @blip/extension",
    "ext:test": "npm run test --workspace @blip/extension",
    "ext:smoke": "tsx scripts/ext-smoke.ts",
    "ext:chrome": "tsx scripts/ext-chrome.ts",
    "pages:build": "npm run build --workspace @blip/test-pages",
    "pages:serve": "npm run serve --workspace @blip/test-pages",
    "gen:extension-key": "tsx scripts/gen-extension-key.ts",
    "fixtures:update": "tsx scripts/gen-golden.ts",
    "protocol:lock": "tsx scripts/gen-lock.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
