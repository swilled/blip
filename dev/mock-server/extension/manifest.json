{
  "manifest_version": 3,
  "name": "Blip Local Form Bridge",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:7777/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:7777/fixtures/forms/broken.html"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
